{
  "notification": {
    "enabled": false,
    "defaultCooldownSeconds": 300,
    "escalationSeconds": 900,
    "smtp": {
      "host": "",
      "port": 587,
      "enableSsl": true,
      "username": "",
      "passwordEnvironmentVariable": "OPSFORGE_SMTP_PASSWORD",
      "fromAddress": "",
      "fromDisplayName": "OpsForge"
    },
    "routes": [
      {
        "id": "critical-generic-webhook",
        "enabled": false,
        "channelType": "webhook",
        "format": "generic",
        "targetEnvironmentVariable": "OPSFORGE_NOTIFY_WEBHOOK",
        "eventTypes": [
          "Opened",
          "Resolved",
          "Escalated"
