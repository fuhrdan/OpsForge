        "suppressDuringMaintenance": true
      },
      {
        "id": "slack-operations",
        "enabled": false,
        "channelType": "webhook",
        "format": "slack",
        "targetEnvironmentVariable": "OPSFORGE_SLACK_WEBHOOK",
