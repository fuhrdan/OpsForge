      },
      {
        "id": "teams-operations",
        "enabled": false,
        "channelType": "webhook",
        "format": "teams",
        "targetEnvironmentVariable": "OPSFORGE_TEAMS_WEBHOOK",
        "eventTypes": [
          "Opened",
