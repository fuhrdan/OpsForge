{
  "agentId": "",
  "displayName": "",
  "site": "Linux Lab",
  "environmentName": "lab",
  "fleetServiceId": "",
  "fleetRuleId": "",
  "fleetRole": "",
  "serverUrl": "https://opsforge.example.internal",
  "heartbeatSeconds": 5,
  "monitoredProcesses": [
    "sshd"
  ],
