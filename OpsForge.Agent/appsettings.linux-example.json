    {
      "id": "local-dns",
      "type": "DNS",
      "target": "localhost",
      "timeoutMs": 1500
    }
  ],
  "apiKey": "",
  "enrollmentToken": "",
  "credentialsFile": "/var/lib/opsforge/agent.credentials.json",
  "allowInsecureRemoteHttp": false,
  "useClientCertificate": true,
  "clientCertificatePfx": "",
  "clientCertificatePassword": ""
}
