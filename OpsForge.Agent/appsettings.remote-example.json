{
  "agentId": "branch-01",
  "displayName": "Branch Node 01",
  "site": "Branch Office",
  "environmentName": "lab",
  "serverUrl": "https://OPSFORGE-SERVER:5443",
  "heartbeatSeconds": 3,
  "monitoredProcesses": [],
  "monitoredServices": [
    "EventLog"
  ],
  "healthChecks": [
    {
      "id": "upstream-http",
      "type": "HTTP",
      "target": "http://APP-SERVER:5091/health",
      "timeoutMs": 2000
    },
    {
      "id": "upstream-tcp",
      "type": "TCP",
      "target": "APP-SERVER",
      "port": 5091,
      "timeoutMs": 1500
    },
    {
      "id": "dns-check",
      "type": "DNS",
      "target": "APP-SERVER",
      "timeoutMs": 1500
    }
  ],
  "apiKey": "",
  "enrollmentToken": "",
  "credentialsFile": "",
  "allowInsecureRemoteHttp": false,
  "useClientCertificate": true,
  "clientCertificatePfx": "",
  "clientCertificatePassword": ""
}
