    },
    {
      "id": "demo-tcp",
      "type": "TCP",
      "target": "127.0.0.1",
      "port": 5091,
      "timeoutMs": 1500
    },
    {
      "id": "local-dns",
      "type": "DNS",
      "target": "localhost",
      "timeoutMs": 1500
    }
  ],
  "apiKey": "",
  "enrollmentToken": "",
  "credentialsFile": "",
  "allowInsecureRemoteHttp": false,
  "useClientCertificate": true,
  "clientCertificatePfx": "",
  "clientCertificatePassword": ""
