{
  "agentId": "",
  "displayName": "",
  "site": "Local Lab",
  "environmentName": "lab",
  "serverUrl": "http://localhost:5080",
  "heartbeatSeconds": 3,
  "monitoredProcesses": [
    "OpsForge.DemoService"
  ],
  "monitoredServices": [
    "EventLog"
